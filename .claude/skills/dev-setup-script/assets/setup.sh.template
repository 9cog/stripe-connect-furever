#!/usr/bin/env bash
#
# setup.sh — one-shot dev environment bootstrap for <PROJECT NAME>
#
# Keep this header in sync with print_help below; the header is for readers
# of the file, print_help is what `./setup.sh --help` shows.

set -euo pipefail

# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT_DIR"

# <Service/container names, image tags, ports, venv dir, etc. go here.
#  Derive image tags from the repo's own Dockerfile / compose file.>
# SERVICE_CONTAINER_NAME="<repo>-<service>"
# SERVICE_IMAGE="<image>:<tag>"
# SERVICE_PORT="<port>"
# VENV_DIR=".venv"

# One SKIP_* flag per phase that is slow, optional, or that a contributor
# might legitimately run elsewhere (databases, queues, language envs).
# SKIP_SERVICE=false
# SKIP_PYTHON=false

print_help() {
  cat <<'EOF'
setup.sh — one-shot dev environment bootstrap for <PROJECT NAME>

What it does:
  1. <phase>
  2. <phase>
  3. <phase>

Usage:
  ./setup.sh                # full setup
  ./setup.sh --no-<service> # skip starting <service> (e.g. you run it elsewhere)
  ./setup.sh --help
EOF
}

for arg in "$@"; do
  case "$arg" in
    # --no-<service>) SKIP_SERVICE=true ;;
    # --no-python)    SKIP_PYTHON=true ;;
    --help|-h)
      print_help
      exit 0
      ;;
    *)
      echo "Unknown option: $arg (use --help)" >&2
      exit 1
      ;;
  esac
done

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
c_reset=$'\033[0m'; c_bold=$'\033[1m'; c_green=$'\033[32m'; c_yellow=$'\033[33m'; c_red=$'\033[31m'; c_blue=$'\033[34m'

step() { echo "${c_bold}${c_blue}==>${c_reset} ${c_bold}$*${c_reset}"; }
info() { echo "    $*"; }
ok()   { echo "    ${c_green}✓${c_reset} $*"; }
warn() { echo "    ${c_yellow}!${c_reset} $*"; }
fail() { echo "    ${c_red}✗${c_reset} $*" >&2; }

has() { command -v "$1" >/dev/null 2>&1; }

# Compare an installed "X.Y.Z" against a pinned "X.Y.Z" / "X" by major version.
# Warn on mismatch rather than fail: adjacent versions usually work, and a hard
# fail on day one is worse than a warning.
check_major() {  # check_major <tool> <installed> <pinned>
  local tool="$1" installed="$2" pinned="$3"
  if [ "${installed%%.*}" != "${pinned%%.*}" ]; then
    warn "$tool v$installed is installed but the project pins $pinned — continuing anyway."
  else
    ok "$tool v$installed"
  fi
}

# Is something already listening on localhost:<port>? Lets us skip starting a
# service the contributor already runs natively.
port_open() {  # port_open <port>
  (exec 3<>"/dev/tcp/127.0.0.1/$1") >/dev/null 2>&1 && exec 3>&- 3<&-
}

